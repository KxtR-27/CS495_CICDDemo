{
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "experimentalOperatorPosition": "start",
    "printWidth": 80,
    "proseWrap": "preserve",
    "quoteProps": "consistent",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
}
